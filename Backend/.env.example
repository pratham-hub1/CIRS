# Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database URL
# Replace YOUR_POSTGRES_PASSWORD with your actual local PostgreSQL password
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/cirs_dev?schema=public"

# Authentication & JWT
JWT_ACCESS_SECRET="cirs-access-secret-key-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_SECRET="cirs-refresh-secret-key-change-in-production-min-32-chars"
JWT_REFRESH_EXPIRATION=604800

# University Domain Restriction (FR-4)
UNIVERSITY_EMAIL_DOMAINS="gsfcuniversity.ac.in"

# Storage
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# Policy Settings
RETENTION_WINDOW_DAYS=365
RATE_LIMIT_TTL=3600
RATE_LIMIT_MAX=20
