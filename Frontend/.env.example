# CIRS Frontend Environment Configuration

# Backend API Base URL
# For direct remote backend: e.g. https://<backend-domain>/api/v1
# Leave empty to route requests through the local Vite dev proxy (/api/v1)
VITE_API_BASE_URL=https://misc-cholesterol-till-benefits.trycloudflare.com/api/v1

# University domain restriction hint for registration validation
VITE_UNIVERSITY_DOMAIN=gsfcuniversity.ac.in

# Default Campus ID (for development / onboarding)
VITE_DEFAULT_CAMPUS_ID=campus-1

# Opt-in demo preview mode (false for real backend operation)
VITE_DEMO_MODE=false
